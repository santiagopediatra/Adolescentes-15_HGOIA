@article{Gotzinger2020,
   abstract = {Summary Background To date, few data on paediatric COVID-19 have been published, and most reports originate from China. This study aimed to capture key data on children and adolescents with severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) infection across Europe to inform physicians and health-care service planning during the ongoing pandemic. Methods This multicentre cohort study involved 82 participating health-care institutions across 25 European countries, using a well established research network—the Paediatric Tuberculosis Network European Trials Group (ptbnet)—that mainly comprises paediatric infectious diseases specialists and paediatric pulmonologists. We included all individuals aged 18 years or younger with confirmed SARS-CoV-2 infection, detected at any anatomical site by RT-PCR, between April 1 and April 24, 2020, during the initial peak of the European COVID-19 pandemic. We explored factors associated with need for intensive care unit (ICU) admission and initiation of drug treatment for COVID-19 using univariable analysis, and applied multivariable logistic regression with backwards stepwise analysis to further explore those factors significantly associated with ICU admission. Findings 582 individuals with PCR-confirmed SARS-CoV-2 infection were included, with a median age of 5·0 years (IQR 0·5–12·0) and a sex ratio of 1·15 males per female. 145 (25%) had pre-existing medical conditions. 363 (62%) individuals were admitted to hospital. 48 (8%) individuals required ICU admission, 25 (4%) mechanical ventilation (median duration 7 days, IQR 2–11, range 1–34), 19 (3%) inotropic support, and one ( Interpretation COVID-19 is generally a mild disease in children, including infants. However, a small proportion develop severe disease requiring ICU admission and prolonged ventilation, although fatal outcome is overall rare. The data also reflect the current uncertainties regarding specific treatment options, highlighting that additional data on antiviral and immunomodulatory drugs are urgently needed. Funding ptbnet is supported by Deutsche Gesellschaft für Internationale Zusammenarbeit.},
   author = {Florian Götzinger and Begoña Santiago-García and Antoni Noguera-Julián and Miguel Lanaspa and Laura Lancella and Francesca I Calò Carducci and Natalia Gabrovska and Svetlana Velizarova and Petra Prunk and Veronika Osterman and Uros Krivec and Andrea Lo Vecchio and Delane Shingadia and Antoni Soriano-Arandes and Susana Melendo and Marcello Lanari and Luca Pierantoni and Noémie Wagner and Arnaud G L'Huillier and Ulrich Heininger and Nicole Ritz and Srini Bandi and Nina Krajcar and Srđan Roglić and Mar Santos and Christelle Christiaens and Marine Creuven and Danilo Buonsenso and Steven B Welch and Matthias Bogyi and Folke Brinkmann and Marc Tebruegge and Jasmin Pfefferle and Angela Zacharasiewicz and Angelika Berger and Roland Berger and Volker Strenger and Daniela S. Kohlfürst and Anna Zschocke and Benoît Bernar and Burkhard Simma and Edda Haberlandt and Christina Thir and Ariane Biebl and Koen Vanden Driessche and Tine Boiy and Daan Van Brusselen and An Bael and Sara Debulpaep and Petra Schelstraete and Ivan Pavic and Ulrikka Nygaard and Jonathan P. Glenthoej and Lise Heilmann Jensen and Ilona Lind and Mihhail Tistsenko and Ülle Uustalu and Laura Buchtala and Stephanie Thee and Robin Kobbe and Cornelius Rau and Nicolaus Schwerk and Michael Barker and Maria Tsolia and Irini Eleftheriou and Patrick Gavin and Oksana Kozdoba and Borbàla Zsigmond and Piero Valentini and Inga Ivaškeviciene and Rimvydas Ivaškevicius and Valentina Vilc and Elisabeth Schölvinck and Astrid Rojahn and Anastasios Smyrnaios and Claus Klingenberg and Isabel Carvalho and Andreia Ribeiro and Anna Starshinova and Ivan Solovic and Lola Falcón and Olaf Neth and Laura Minguell and Matilde Bustillo and Aida M. Gutiérrez-Sánchez and Borja Guarch Ibáñez and Francesc Ripoll and Beatriz Soto and Karsten Kötz and Petra Zimmermann and Hanna Schmid and Franziska Zucol and Anita Niederer and Michael Buettcher and Benhur S. Cetin and Olga Bilogortseva and Vera Chechenyeva and Alicia Demirjian and Fiona Shackley and Lynne McFetridge and Lynne Speirs and Conor Doherty and Laura Jones and Paddy McMaster and Clare Murray and Frances Child and Yvonne Beuvink and Nick Makwana and Elisabeth Whittaker and Amanda Williams and Katy Fidler and Jolanta Bernatoniene and Rinn Song and Zoe Oliver and Andrew Riordan},
   doi = {10.1016/s2352-4642(20)30177-2},
   issn = {23524642},
