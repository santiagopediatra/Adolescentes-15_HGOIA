@article{GarcaBautista2021,
   abstract = {<p>Este es un estudio cualitativo con objetivo de indagar cómo es el involucramiento de los padres desde el parto y cómo es la participación de los padres durante el postparto, identificando facilitadores de las prácticas de lactancia materna exclusiva. Se escucharon las voces de diez madres en periodo de lactancia, y cuatro padres con hijos menores de seis meses, por medio de entrevistas semiestructuradas. Se utilizó una matriz de análisis, encontrando que todas las mujeres consideran importante la presencia de la pareja desde el parto. Algunas actividades en las que participan los padres son en labores del hogar, alimentación con biberón de leche materna o fórmula, cargar, bañar al bebé y cuidados de hijos mayores.</p>},
   author = {Mayra García Bautista},
