@article{Ward.2016,
   abstract = {Hay una expectativa creciente de que los usuarios del servicio deben contribuir de manera significativa a los cursos de formación de las enfermeras de estudiante. En este artículo se describe cómo la retroalimentación usuario de servicio en el rendimiento de los estudiantes de enfermería de grado 'durante la práctica de oportunidades de aprendizaje (PLoS) da una idea del valor usuarios de los servicios cualidades de los estudiantes de enfermería. En la Universidad de Cardiff, la nueva Licenciatura en Enfermería curso, que se inició en septiembre de 2012, tuvo en cuenta el nivel Obstetricia (NMC) de enfermería y de pre-registro, la implementación de un mecanismo para que los usuarios de servicios de retroalimentar el desempeño clínico de los estudiantes. Para facilitar este servicio, las páginas de opinión de usuario / cuidador se insertaron en cota cartera de la práctica clínica de los estudiantes. Una amplia muestra de las carteras clínicos (n = 100) de una cohorte través adulto, niño y campos enfermería en salud mental se examinaron al final del año 1, año 2 y de nuevo al final del año 3, y los comentarios de los usuarios de servicios cotejada . Al considerar las palabras utilizadas por los usuarios del servicio, los autores proponen que reflejaban los seis valores fundamentales 6CS-o-de la atención, la compasión, la competencia, la comunicación, el coraje y el compromiso que sostienen el servicio de cuidado excelente. Las conclusiones extraídas de las votaciones en que los estudiantes exhiben las cualidades que cuidan y profesionales que el valor de los usuarios del servicio, y de hecho mostraron la dignidad y el respeto de los pacientes y las personas que la profesión exige.},
   author = {S Ward. and J Benbow.},
   doi = {10.12968/bjon.2016.25.13.752},
   isbn = {0966-0461},
   issue = {13},
   journal = {British Journal of Nursing},
   pages = {752-756},
   title = {The role of service-user feedback in undergraduate nursing courses},
   volume = {25},
   url = {http://www.magonlinelibrary.com/doi/full/10.12968/bjon.2016.25.13.752 file:///Users/santiagovasco/Zotero/storage/E8XXVJMG/bjon.2016.25.13.html},
   year = {2016}
}
