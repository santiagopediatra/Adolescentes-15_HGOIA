@article{Dionne2025,
   abstract = {Neonatal hypertension occurs in 1% to 2% of infants in the NICU but is rare in otherwise healthy newborns. Hypotension is more commonly encountered than hypertension, and at least one study suggests that up to 25% of infants with hypertension go untreated. Although antihypertensive medications are not approved for use in neonates and infants, clinicians have been using them in hypertensive infants for years with apparent efficacy. A cause or risk factor for the hypertension can be found in most infants and may help direct treatment. Fortunately, most neonatal hypertension resolves during the first months or years of life if an underlying condition is not found. This chapter will describe the best evidence-based recommendations for blood pressure measurement and norms and for the diagnosis, evaluation, and management of neonatal hypertension.},
   author = {Janis M. Dionne and Joseph T. Flynn},
