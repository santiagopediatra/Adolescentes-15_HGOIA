   issue = {6},
   journal = {Revista da Associação Médica Brasileira},
   pages = {585-590},
   title = {Intrauterine growth restriction in monochorionic-diamniotic twins},
   volume = {60},
   url = {http://www.scielo.br/scielo.php?script=sci_abstract&pid=S0104-42302014000600585&lng=en&nrm=iso&tlng=en file:///Users/santiagovasco/Zotero/storage/IVRB74KH/scielo.html},
   year = {2014}
