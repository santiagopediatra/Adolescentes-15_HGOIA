@article{LpezFuentetajaa2018,
   abstract = {Se presenta el recorrido de un grupo de padres en situación de duelo perinatal, llevado a cabo en el Hospital Universitario 12 de Octubre de Madrid. Esta experiencia forma parte de un Programa de Enlace acordado entre los Servicios de Neonatología y Ginecología-Obstetricia y el de Psiquiatría y Salud Mental, para la atención psicológica a padres que afrontan la muerte perinatal de su bebé, o que este presente un grave riesgo vital. La complejidad de este tipo de duelo involucra un plano real y otro simbólico, que precisa la elaboración a un nivel particular y también como pareja de padres. El trabajo en grupo de padres aporta la posibilidad de expresar y compartir los sentimientos íntimos derivados de la pérdida, en un marco de contención que facilita la elaboración del duelo.},
   author = {Ana M. López Fuentetajaa and Odei Iriondo Villaverdeb},
   doi = {10.5093/CC2018A21},
   issn = {1130-5274},
   issue = {3},
