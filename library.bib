@article{Martinez2015,
   abstract = {IntroducciónEn México, la mortalidad en menores de un año es de 14.1 por cada 1.000 nacidos vivos. La primera causa de esta mortalidad son las afecciones del periodo perinatal entre los que se encuentra el síndrome de dificultad respiratoria (SDR). La edad media de estos pacientes es de 29.1 semanas de gestación, peso de 1,000 g, con tratamiento de elección el uso de surfactante y ventilación mecánica. Para este grupo es importante crear un entorno que favorezca su integridad; para lo cual hay estrategias como contacto piel a piel. Con base en lo anterior, se elabora un estudio de caso con el objetivo de lograr la independencia del neonato.MétodoSe utiliza la metodología del proceso de atención de enfermería (PAE) y el modelo de las 14 necesidades de Virginia Henderson. Previo consentimiento informado se aborda la situación; para obtener información se usaron fuentes directas e indirectas y búsqueda en bases de datos. Durante el diagnóstico se identificaron 8 diagnósticos reales, 2 de riesgo y 2 de bienestar. Se jerarquizan las necesidades alteradas y se abordan la necesidad de oxigenación por el compromiso ventilatorio y la de realización por ser un producto de embarazo no planeado. La planeación y ejecución se realiza con base en la mejor evidencia.Resultados y conclusiónDe acuerdo al objetivo, se logró su independencia, el neonato y la mamá se encuentran en su domicilio sin complicaciones aparentes.Palabras clave Prematuro; Síndrome de dificultad respiratoria del recién nacido; Cuidados de enfermería; México},
   author = {C Martínez and G Romero},
   doi = {10.1016/j.reu.2015.07.001},
   isbn = {1665-7063},
   issue = {3},
   journal = {Enfermería universitaria},
   pages = {160-170},
   title = {Neonato pretérmino con dependencia en la necesidad de oxigenación y realización},
   volume = {12},
   url = {http://www.scielo.org.mx/scielo.php?script=sci_abstract&pid=S1665-70632015000300160&lng=es&nrm=iso&tlng=es file:///Users/santiagovasco/Zotero/storage/G2U72ES4/scielo.html},
   year = {2015}
}
