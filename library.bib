@article{Lamarra2016,
   abstract = {El advenimiento del “Estado evaluador”, en la década de los noventa, afirma la calidad de la educación en el escenario y agenda de la educación superior como un concepto clave: un bien público y determinante de la competitividad del país. La “profesión académica” como objeto de investigación ha cobrado importancia en las últimas décadas, de forma paralela al crecimiento y afianzamiento de la educación superior como campo de investigación. En Argentina, el tema de la evaluación de la docencia universitaria constituye un área de vacancia que, a la vez, limita la interpretación de los estudios que toman como objeto los cambios en nuestro sistema de educación superior. En este trabajo, proponemos desarrollar un panorama general sobre la evaluación de la docencia universitaria en Argentina, a partir de distintas fuentes de información y del análisis de experiencias realizadas en diversas universidades y de datos preliminares obtenidos de la encuesta del Proyecto The Changing Academic Profesión (CAP).Palabras clave: Docencia universitaria, educación superior, evaluación, Argentina. With the advent of the “Evaluation State”, in the 90’s, affirms that the quality of the education seen through the scenario and agenda of higher education is a key concept: a public good decisive in the countries competence. The “academic profession” as an object of investigation has gain notoriety during the last decades, parallel to growth o of higher education as a viable subject for investigative works. In Argentina, the subject of university teaching evaluation is a vacant area that limits the interpretation of studies on the changes of our higher education system. This article proposes the development of a general view of the teaching process at Argentinean universities starting from different information sources and the analysis of experiences at different universities as well as prelimary data obtained by The Changing Academic Profession (CAP) project.Keywords: Teaching process at universities, higher education, evaluation, Argentina.},
   author = {Norberto Fernández Lamarra and Natalia Coppola},
   isbn = {1989-0397},
   issue = {3e},
   journal = {Revista Iberoamericana de Evaluación Educativa},
   title = {La Evaluación de la Docencia Universitaria en Argentina. Situación, Problemas y Perspectivas},
   volume = {1},
   url = {https://revistas.uam.es/index.php/riee/article/view/4657 file:///Users/santiagovasco/Zotero/storage/7MEIAWN8/4657.html},
   year = {2016}
}
