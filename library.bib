   publisher = {OPS},
   title = {Guía de práctica clínica para el manejo de la retinopatía de la prematuridad},
   url = {https://iris.paho.org/handle/10665.2/34948 https://iris.paho.org/bitstream/handle/10665.2/34948/9789275320020_spa.pdf?sequence=6},
   year = {2018}
