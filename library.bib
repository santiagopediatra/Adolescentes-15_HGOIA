@inproceedings{FloresJcome2024,
   abstract = {La retinopatía del prematuro (RDP) es la principal causa de ceguera infantil en el mundo, por tal razón el tamizaje oftalmológico oportuno se convierte en la herramienta indispensable para su diagnóstico y tratamiento. La RDP es una neuroretinopatía vasoproliferativa de la retina postnatal,la cual esta incompletamente vascularizada, causando un desarrollo anormal de tejido fibrovascular en la retina vascular, se acompaña de edema , inflamación y finalmente el desprendimiento de la misma . La clasificación de la enfermedad se le realiza de acuerdo a zona, estadios, extensión y la presencia o no de tortuosidades en la vasos.

Existen varios factores que predisponen al prematuro para el desarrollo de esta patología en donde se incluyen menor edad gestacional, ventilación mecánica, sepsis, factores nutricionales, transfusiones entre otros. Sin embargo, el uso de oxígeno en neonatos prematuros es la principal causa de esta patología.},
   author = {K. M. Flores Jácome and M. A. Ordoñez Serpa and M. A. Moya Almeida and V. K. Oliva Velasco and R. P. Castillo Alvarez and P. E. Alarcón Andrade},
