   pages = {E25, 1-24},
   publisher = {Colegio Oficial de Psicologos de Madrid (copmadrid)},
   title = {Sentir y pensar el duelo perinatal: acompañamiento emocional de un grupo de padres},
   volume = {9},
   url = {https://www.revistaclinicacontemporanea.org https://www.revistaclinicacontemporanea.org#resumen},
