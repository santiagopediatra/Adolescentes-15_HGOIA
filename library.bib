@article{a._conde-taboada_dermatitis_2008,
   abstract = {Resumen La dermatitis atópica infantil es una enfermedad de distribución mundial, con una elevada prevalencia en los países desarrollados, lo que la ha convertido en una prioridad de salud. A pesar de que es una entidad que ha sido estudiada durante años todavía existen numerosas controversias en distintas áreas. En esta revisión se comentan los principales trabajos publicados sobre el tema, actualizando diversos conceptos: terminología aplicada (diferencia entre atópica y atopiforme), epidemiología, etiopatogenia (estudios moleculares, genes implicados y factores ambientales), medida de la gravedad, influencia en la calidad de vida del paciente y la familia, impacto económico y tratamientos. Although childhood atopic dermatitis is reported throughout the world, it has become a health priority in developed countries, where its prevalence is particularly high. Despite extensive study for many years, various aspects of the disease are still subject to debate. This review will discuss the main studies published on the topic and update certain concepts such as the terminology used (the difference between atopic and atopiform), epidemiology, etiopathogenesis (molecular mechanisms, implicated genes, and environmental factors), assessment of severity, influence on the quality of life of the patients and their families, economic impact, and treatment.},
   author = {A Conde-Taboada and F J González-Barcala and J Toribio and A. Conde-Taboada and F. J. González-Barcala and J. Toribio},
   doi = {10.1016/S0001-7310(08)76173-8},
   isbn = {0001-7310},
   issn = {0001-7310},
   issue = {9},
   journal = {Actas Dermo-Sifiliográficas},
   keywords = {atopic dermatitis,calidad de vida,costos y análisis de costo,costs,costs analysis,dermatitis atópica,epidemiology,epidemiología,quality of life},
   pages = {690-700},
   title = {Dermatitis atópica infantil: revisión y actualización},
   volume = {99},
   url = {http://www.sciencedirect.com/science/article/pii/S0001731008761738 file:///Users/santiagovasco/Zotero/storage/PAN3WUTF/S0001731008761738.html},
   year = {2008}
}
