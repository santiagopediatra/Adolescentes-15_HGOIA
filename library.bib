@article{Guevara-Aguirre1995,
   abstract = {GH insensitivity due to GH receptor deficiency is a rare autosomal recessive condition, characterized by deletions or mutations of the GH receptor gene. Patients are refractory to both endogenous and exogenous GH, resulting in severe growth retardation. Therapy with recombinant human insulin-like growth factor-I (rhIGF-I) can bypass the defect in the GH receptor and potentially stimulate growth. We previously identified a genetically homogeneous group of patients in southern Ecuador, thus providing a patient base for a controlled clinical trial of rhIGF-I therapy. Seventeen prepubertal patients were entered in a randomized, double blind, placebo-controlled trial. Subjects received either a 12-month course of rhIGF-I (120 micrograms/kg, sc, daily) or 6 months of placebo followed by 6 months of rhIGF-I. Subjects receiving rhIGF-I showed a significant increase in growth rate, which was sustained over the 1-yr course of therapy (from 2.9 +/- 0.6 to 8.6 +/- 0.4 cm/yr). Incidents of hypoglycemia were equal in frequency in the placebo and rhIGF-I groups. One recipient of rhIGF-I developed papilledema, which resolved spontaneously. rhIGF-I therapy did not alter serum IGF-binding protein-3 concentrations. rhIGF-I treatment is effective in stimulating skeletal growth in GH receptor deficiency. Although the therapy proved to be safe, the potent metabolic actions of rhIGF-I and the persistently low levels of serum IGF carrier protein necessitate continued careful observation for side-effects.},
   author = {Jaime Guevara-Aguirre and Oswaldo Vasconez and Victor Martinez and Lucia Ana Martinez and Arlan L Rosenbloom and Frank B Diamond and Sharron E Gargosky and Leni Nonoshita and Ron G Rosenfeld},
   doi = {10.1210/jcem.80.4.7536209},
   issn = {19457197},
   issue = {4},
   journal = {Journal of Clinical Endocrinology and Metabolism},
   keywords = {autosomal recessive inheritance,bypass,child,growth rate,growth retardation,hypoglycemia,insulin-like growth factor i,laron syndrome,prepuberty},
   month = {4},
   pages = {1393-1398},
   publisher = {Narnia},
   title = {A randomized, double blind, placebo-controlled trial on safety and efficacy of recombinant human insulin-like growth factor-I in children with growth hormone receptor deficiency},
   volume = {80},
   url = {https://academic.oup.com/jcem/article-lookup/doi/10.1210/jcem.80.4.7536209},
   year = {1995}
}
