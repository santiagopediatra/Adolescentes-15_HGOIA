   issue = {n/a},
   journal = {Pediatric Pulmonology},
   keywords = {children,clinical characteristics,coronavirus disease 2019},
   month = {4},
   note = {<b>From Duplicate 1 (<i>Novel coronavirus infection in children outside of Wuhan, China</i> - Shen, Qinxue; Guo, Wei; Guo, Ting; Li, Jinhua; He, Wenlong; Ni, Shanshan; Ouyang, Xiaoli; Liu, Jiyang; Xie, Yuanlin; Tan, Xin; Zhou, Zhiguo; Peng, Hong)<br/></b><br/>doi: 10.1002/ppul.24762},
