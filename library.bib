   title = {Growth hormone receptor deficiency in Ecuador: Clinical and biochemical phenotype in two populations},
   volume = {76},
   url = {file:///Users/santiagovasco/Zotero/storage/NJZZA2F8/15520564_Growth_hormone_receptor_deficiency_in_Ecuador_Clinical_and_biochemical_phenotype_in_tw.html http://www.ncbi.nlm.nih.gov/pubmed/7679400 https://academic.oup.com/jcem/article-lookup/doi/10.1210/jc},
