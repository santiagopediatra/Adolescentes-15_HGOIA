   doi = {10.1385/JMN:14:3:191},
   issn = {0895-8696},
   issue = {3},
   journal = {Journal of Molecular Neuroscience},
   keywords = {80 and over Cerebra,Acute Disease Adult Aged Aged},
   month = {6},
   note = {<b>From Duplicate 2 (<i>Reduced IL-2 But Elevated IL-4, IL-6, and IgE Serum Levels in Patients with Cerebral Infarction During the Acute Stage</i> - Kim, Hyung-Min; Shin, Hye-Young; Jeong, Hyun-Ja; An, Hyo-Jin; Kim, Nam-Song; Chae, Han-Jung; Kim, Hyung-Ryong; Song, Ho-Joon; Kim, Kyung-Yo; Baek, Seung-Hwa; Cho, Kwang-Ho; Moon, Byung-Soon; Lee, Young-Mi)<br/></b><br/>Kim, H M<br/>Shin, H Y<br/>Jeong, H J<br/>An, H J<br/>Kim, N S<br/>Chae, H J<br/>Kim, H R<br/>Song, H J<br/>Kim, K Y<br/>Baek, S H<br/>Cho, K H<br/>Moon, B S<br/>Lee, Y M<br/>eng<br/>Research Support, Non-U.S. Gov't<br/>2000/09/13<br/>J Mol Neurosci. 2000 Jun;14(3):191-6. doi: 10.1385/JMN:14:3:191.},
   pages = {191-196},
